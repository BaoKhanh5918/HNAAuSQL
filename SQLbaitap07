bài tạp 4 
db.san_pham.aggregate([
  {
    $match: { danh_muc: "Cà Phê Pha Máy" }
  },
  {
    $group: {
      _id: "$danh_muc",
      gia_trung_binh: { $avg: "$gia_ban" }
    }
  }
])
bài tập 5 
db.san_pham.aggregate([
  {
    $group: {
      _id: "$danh_muc",
      tong_so_luong: { $sum: "$so_luong_ban" }
    }
  },
  {
    $match: { tong_so_luong: { $gt: 500 } }
  },
  {
    $sort: { tong_so_luong: -1 }
  }
])
